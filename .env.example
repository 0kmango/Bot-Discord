# ============================================================
#  Mango Bot - plantilla de configuración
#  Copia este archivo como ".env" y rellena los valores reales.
#     cp .env.example .env
#  El archivo .env está en .gitignore: nunca se sube al repo.
# ============================================================

# --- Discord (obligatorio) ---
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# IDs de los dueños del bot (tu ID de usuario), separados por comas.
# Se usa para comandos privados como !embed.
# Activa el modo desarrollador en Discord y copia tu ID de usuario.
OWNER_IDS=

# --- Comportamiento general ---
COMMAND_PREFIX=!
LOG_LEVEL=INFO

# --- Voz y reproducción ---
# Segundos de inactividad antes de desconectarse solo (600 = 10 min)
IDLE_TIMEOUT=600
# Segundos de margen cuando el canal se queda sin humanos
ALONE_GRACE=20
# Volumen inicial (0.0 a 2.0; 0.5 = 50 %)
DEFAULT_VOLUME=0.5
# Máximo de canciones en cola y máximo por playlist importada
MAX_QUEUE=100
MAX_PLAYLIST_TRACKS=50

# --- Spotify (opcional: permite links de Spotify) ---
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Genius (opcional: comando !lyrics) ---
# Opción A: access token directo -> https://genius.com/api-clients
GENIUS_TOKEN=
# Opción B: credenciales de cliente (el bot pide el token por OAuth)
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=

# --- Cookies de YouTube (opcional) ---
# Archivo cookies.txt exportado del navegador; ayuda con videos
# que requieren iniciar sesión o tienen restricción de edad.
# YTDLP_COOKIES=cookies.txt

# ============================================================
#  Mango AI (texto + voz)
# ============================================================
# Canal de texto donde Mango AI responde SIN prefijo (opcional).
# Con `!mango <pregunta>` ya funciona en cualquier canal de texto.
AI_CHANNEL_ID=

# --- Cerebro (LLM): cualquier API compatible con OpenAI ---
# Token Harbor (gateway con 78 modelos, varios gratis ":free"):
#   https://tokenharbor.ai/v1 · p. ej. mimo-v2.6-flash:free, qwen3.8-flash
# Ollama Cloud (gratis con cuenta): https://ollama.com/v1 · gpt-oss:120b
# OpenAI:  https://api.openai.com/v1        · modelo gpt-4o-mini
# Groq:    https://api.groq.com/openai/v1
#          · openai/gpt-oss-20b  ← el más rápido (≈0,8 s) y llama bien a las herramientas
#          · openai/gpt-oss-120b (más listo, ≈1,2 s)
#          · whisper-large-v3 / whisper-large-v3-turbo (voz)
# Ollama local: http://localhost:11434/v1   · modelo qwen2.5:7b (API_KEY=ollama)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
# Modelos con razonamiento (gpt-oss, nemotron…) responden más rápido en "low".
# Vacío = no se envía el parámetro.
LLM_REASONING_EFFORT=

# --- Respaldo opcional: si el principal falla, se usa este ---
# Ejemplo con Token Harbor (usa modelos gratis terminados en ":free").
# LLM_FALLBACK_BASE_URL=https://tokenharbor.ai/v1
# LLM_FALLBACK_API_KEY=thk_live_...
# LLM_FALLBACK_MODEL=deepseek-v4.1-flash:free

# Cuántos mensajes de memoria recuerda por conversación
AI_HISTORY_LIMIT=20
# Tope de caracteres por respuesta
AI_MAX_REPLY_CHARS=1500

# --- Oído (STT) ---
# local         = faster-whisper en CPU (gratis, sin API)
# groq / openai = API de transcripción (mucho más rápido: ~0,5 s por frase)
#   Recomendado: groq + whisper-large-v3-turbo (usa la misma clave que el LLM)
STT_PROVIDER=local
STT_MODEL=small
STT_LANGUAGE=es
# Solo si STT_PROVIDER no es "local"
STT_API_KEY=
STT_BASE_URL=
# Modelo pequeño solo para oír «oye mango» cuando el STT es local
# (tiny = 5 veces más rápido que small y el comparador tolera sus fallos)
VOICE_WAKE_MODEL=tiny
# Fuera de conversación, los audios más largos que esto NO se transcriben
# (así la música o una charla larga no pasan por el reconocedor)
VOICE_WAKE_MAX_SECONDS=6
# true = transcribir absolutamente todo (más lento y menos privado)
VOICE_TRANSCRIBE_ALL=false
# Mostrar en Discord el texto que se oyó (mejor dejarlo en false)
VOICE_SHOW_TRANSCRIPT=false
# Dejar en el canal de texto la respuesta que dio por voz.
# false = lo que se habla por voz NO deja rastro en el chat (recomendado).
# Los comandos de texto (!mango, canal de IA) sí responden siempre en el chat.
VOICE_POST_REPLIES=false
# Voz de respaldo: si el proveedor principal es de red (edge, elevenlabs,
# openai, gemini) y falla, Mango sigue hablando con la voz local (Piper
# es_MX-ald-medium). No hay que configurar nada; solo tener el modelo en models/.
# Volumen de la voz de Mango (1.0 = sin tocar). 1.8 = +80% de nivel con
# limitador suave; súbelo si te cuesta oírlo con la música puesta (máx. 3.0).
TTS_GAIN=1.8
# Velocidad de la voz. +0% es más pausado y agradable; +10% responde antes.
TTS_RATE=+0%

# --- Voz (TTS) ---
# edge        gratis, decente        (Microsoft, sin clave)
# piper       gratis y OFFLINE, la más rápida (0,2 s/frase)  -> ./run.sh --voices  (Windows: run.bat --voices)
# kokoro      gratis y OFFLINE, más natural (2 s/frase)      -> ./run.sh --voices  (Windows: run.bat --voices)
# local       gratis y OFFLINE: elige sola (Piper si está, si no Kokoro)
# openai      muy natural            (platform.openai.com · gpt-4o-mini-tts)
# elevenlabs  la más humana          (elevenlabs.io · 10k caracteres/mes gratis)
# gemini      natural y barata       (aistudio.google.com · capa gratuita)
TTS_PROVIDER=edge
# Voz según el proveedor:
#   edge        es-PE-AlexNeural (recomendada: masculina, cálida y clara)
#               otras masculinas latinas: es-CR-JuanNeural, es-US-AlonsoNeural,
#               es-CO-GonzaloNeural, es-AR-TomasNeural, es-MX-JorgeNeural
#               femeninas: es-MX-DaliaNeural, es-ES-ElviraNeural
#   openai      nova, alloy, shimmer, coral, sage
#   elevenlabs  ID de la voz (p. ej. EXAVITQu4vr4xnSDxMaL = Sarah, multilingüe)
#   gemini      Kore, Puck, Charon, Fenrir, Aoede, Leda
#   piper       es_MX-claude-high (México femenina, la más rápida), es_MX-ald-medium (MX masculina),
#               es_AR-daniela-high (AR femenina, lenta), es_ES-davefx-medium, es_ES-sharvard-medium
#   kokoro      ef_dora (femenina), em_alex, em_santa
# Recomendada para TTS_PROVIDER=edge (masculina, cálida, español latino):
TTS_VOICE=es-PE-AlexNeural
# Si usas piper: es_MX-claude-high (MX femenina), es_MX-ald-medium (MX masculina)
# Modelo según el proveedor (vacío = el de por defecto):
#   openai gpt-4o-mini-tts · elevenlabs eleven_flash_v2_5 · gemini gemini-2.5-flash-preview-tts
#   piper: ruta del .onnx (vacío = models/es_MX-claude-high.onnx)
# Voces locales: descárgalas con  ./run.sh --voices  (Windows: run.bat --voices)
TTS_MODEL=
# Clave y endpoint del proveedor (no hacen falta para edge ni para las voces locales)
TTS_API_KEY=
TTS_BASE_URL=

# --- Charla por voz ---
# DAVE/E2EE: deja "auto". Discord cifra la voz de extremo a extremo y el bot
# la descifra con davey. La sesión solo se activa con más de una persona en el
# canal (con el bot solo verás lista=False, es normal).
# "off" NO funciona donde Discord exige E2EE: cierra la conexión con código 4017.
VOICE_DAVE=auto
# Canal de voz al que el bot entra SOLO al arrancar (opcional).
# La escucha de «oye Mango» funciona en cualquier canal de voz donde esté.
AI_VOICE_CHANNEL_ID=
# Palabras de activación separadas por comas
WAKE_WORDS=oye mango,hey mango,hola mango,escucha mango
# Silencio (ms) que cierra una frase
VOICE_SILENCE_MS=400
# Duración mínima de voz (ms) para procesar una frase
VOICE_MIN_SPEECH_MS=250
# Umbral de energía del VAD (súbelo si hay mucho ruido de fondo)
VOICE_ENERGY=0.012
# Umbral cuando hay MÚSICA sonando. El micrófono del usuario suele captar la
# música; sin un umbral más alto el detector la tomaría por voz, la frase nunca
# se cerraría y Mango no contestaría mientras reproduce. Con esto además se
# aparta (ducking) la música al detectar voz.
VOICE_ENERGY_MUSIC=0.03
# Segundos que la conversación sigue abierta tras cada respuesta.
#   0 = hay que decir «oye Mango» en CADA petición (modo estricto).
#  >0 = conversación fluida: se sigue el hilo sin repetir la palabra clave.
#       Con VOICE_CONVERSATION_FILTER=true solo responde a lo que va dirigido a
#       él (órdenes y preguntas); la charla con otras personas la ignora.
VOICE_SESSION_TIMEOUT=25
# Filtro de intención dentro de la conversación (recomendado: true).
VOICE_CONVERSATION_FILTER=true
# ¿Puede cualquiera que esté escuchando pedir «!mango di <texto>»?
# false = solo el dueño (la voz del bot es su identidad).
VOICE_SAY_PUBLIC=false
# Borrar el historial de conversación al arrancar: el bot empieza sin
# memoria (no «recuerda» canciones ni temas de la sesión anterior).
CLEAR_MEMORY_ON_START=true
# Si tras «oye Mango» se oye algo que no se entiende (audio de 1,8 s o más),
# te lo dice por voz. Si solo dijo «oye Mango» y nada más, se queda callado y
# sigue con lo que estaba.
# (umbral interno NO_ENTENDI_MIN_SEGUNDOS = 1,8 s en cogs/ai_voice.py)
